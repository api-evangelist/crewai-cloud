      "item": [
        {
          "id": "3022dc44-16cc-4585-a961-6715ea50f867",
          "name": "Resume Crew with Human Feedback",
          "request": {
            "name": "Resume Crew with Human Feedback",
            "description": {
              "content": "Resumes a crew execution that paused for human-in-the-loop review. Supply\n`execution_id` and `task_id`, the reviewer's `human_feedback`, and `is_approve`\n(`true` to proceed, `false` to retry the task with the feedback as additional context).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resume"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The crew slug from the AMP dashboard.",
                  "type": "any",
                  "value": "{{crewName}}",
                  "key": "crewName"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"execution_id\": \"<uuid>\",\n  \"task_id\": \"<string>\",\n  \"human_feedback\": \"<string>\",\n  \"is_approve\": \"<boolean>\",\n  \"taskWebhookUrl\": \"<uri>\",\n  \"stepWebhookUrl\": \"<uri>\",\n  \"crewWebhookUrl\": \"<uri>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
